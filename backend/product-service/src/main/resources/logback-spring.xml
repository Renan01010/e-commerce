<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="product-service" />
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <logLevel><fieldName>level</fieldName></logLevel>
                <loggerName><fieldName>logger</fieldName></loggerName>
                <message><fieldName>message</fieldName></message>
                <mdc>
                    <includeMdcKeyName>correlationId</includeMdcKeyName>
                </mdc>
                <pattern>
                    <pattern>{"service":"${serviceName}"}</pattern>
                </pattern>
                <stackTrace />
            </providers>
        </encoder>
    </appender>
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="JSON_CONSOLE" />
    </root>
</configuration>